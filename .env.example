NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
DATABASE_URL=postgres://onegov:onegov@localhost:5432/onegov
JWT_ACCESS_SECRET=dev-access-secret-please-change-32-chars-min
JWT_REFRESH_SECRET=dev-refresh-secret-please-change-32-chars-min
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
OTP_TTL=300
OTP_LENGTH=6
FAYDA_CLIENT_ID=dev-fayda-client
FAYDA_CLIENT_SECRET=dev-fayda-secret
FAYDA_BASE_URL=https://api.fayda.et
FAYDA_REDIRECT_URI=http://localhost:4000/api/auth/fayda/callback
EKYC_ENCRYPTION_KEY=dev-ekyc-encryption-key-32-chars-min
PAYMENT_PROVIDER=stub
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_MIME=application/pdf,image/jpeg,image/png
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
CSRF_SECRET=dev-csrf-secret-min-16-chars
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
SMS_PROVIDER=stub
